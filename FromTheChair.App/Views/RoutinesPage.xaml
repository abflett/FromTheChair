<Page x:Class="FromTheChair.App.Views.RoutinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36" Spacing="24" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Routines" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
                <StackPanel Spacing="18">
                    <FontIcon Glyph="&#xE7C1;" FontSize="32" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Your movement starts here." Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="There aren't any routines yet. This will be your place to choose exercises and follow along with a video and timer." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Routine creation is coming in a future update." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
