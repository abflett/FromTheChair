<Window x:Class="FromTheChair.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="From the Chair">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <NavigationView x:Name="Navigation" Loaded="Navigation_Loaded" SelectionChanged="Navigation_SelectionChanged"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="True" PaneDisplayMode="Auto"
                    OpenPaneLength="228" IsPaneOpen="True" AlwaysShowHeader="False" PaneTitle="From the Chair">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
            <NavigationViewItem Content="Routines" Tag="routines">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Progress" Tag="progress">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
</Window>
